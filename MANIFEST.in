# Make sure that only the Python module part of the Git repository is included
# in the installation ...
exclude .coverage.ini
exclude .editorconfig
exclude .github/*
exclude .github/*/*
exclude .gitignore
exclude .gitmodules
exclude .mypy.ini
exclude .pylint.ini
exclude .readthedocs.yaml
exclude .shellcheckrc
exclude bugs/*
exclude bugs/*/*
exclude bugs/*/*/*
exclude bugs/*/*/*/*
exclude bugs/*/*/*/*/*
exclude DEVELOP.md
exclude docs/*
exclude docs/*/*
exclude docs/*/*/*
exclude docs/*/*/*/*
exclude docs/*/*/*/*/*
exclude Makefile
exclude README.md
exclude requirements.txt
exclude scripts/*
exclude scripts/*/*
exclude scripts/*/*/*
exclude scripts/*/*/*/*
exclude scripts/*/*/*/*/*
exclude tests/*
exclude tests/*/*
exclude tests/*/*/*
exclude tests/*/*/*/*
exclude tests/*/*/*/*/*
exclude unitTests.py

# Make sure that the installation is less than the 100 MB upload limit of PyPI ...
# NOTE: These are files which are known by Git and in the repository but which
#       are excluded from the build.
exclude pyguymer3/*/README.md
exclude pyguymer3/*/*/README.md
exclude pyguymer3/*/*/*/README.md
exclude pyguymer3/data/png/gshhg/64x32/res=*/x=*/y=*.png
exclude pyguymer3/data/png/ne/64x32/res=*/x=*/y=*.png
exclude pyguymer3/data/png/osTerrain/22x41/maxElev=250m/x=*/y=*.png
exclude pyguymer3/data/png/osTerrain/22x41/maxElev=500m/x=*/y=*.png
exclude pyguymer3/data/png/osTerrain/22x41/maxElev=750m/x=*/y=*.png
exclude pyguymer3/data/png/osTerrain/22x41/maxElev=1250m/x=*/y=*.png
